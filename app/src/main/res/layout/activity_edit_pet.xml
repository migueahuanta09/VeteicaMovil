<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Barra azul -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#0c607d"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_back"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="@android:color/white"
                    android:contentDescription="Volver"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Editar Paciente"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"/>

                <TextView
                    android:id="@+id/btnSaveToolbar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guardar"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"/>

            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Foto de la mascota -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginBottom="24dp"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground"
                android:id="@+id/layoutPhoto">

                <androidx.cardview.widget.CardView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    app:cardCornerRadius="50dp"
                    app:cardElevation="4dp">

                    <ImageView
                        android:id="@+id/ivPetPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_pet"
                        android:scaleType="centerCrop"
                        android:padding="20dp"
                        android:tint="#2E7D32"/>

                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cambiar foto"
                    android:textColor="#2E7D32"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

            <!-- Card de información -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Nombre -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nombre:"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nombre de la mascota"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:background="@drawable/bg_edit_text"
                        android:padding="12dp"
                        android:layout_marginBottom="16dp"/>

                    <!-- Especie -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Especie:"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:layout_marginBottom="4dp"/>

                    <Spinner
                        android:id="@+id/spinnerSpecies"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_edit_text"
                        android:padding="8dp"
                        android:layout_marginBottom="16dp"/>

                    <!-- Raza (SPINNER) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Raza:"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:layout_marginBottom="4dp"/>

                    <Spinner
                        android:id="@+id/spinnerBreed"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_edit_text"
                        android:padding="8dp"
                        android:layout_marginBottom="16dp"/>

                    <!-- Edad y Peso -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Edad (años):"
                                android:textSize="12sp"
                                android:textColor="#999999"
                                android:layout_marginBottom="4dp"/>

                            <EditText
                                android:id="@+id/etAge"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Edad"
                                android:textSize="14sp"
                                android:textColor="#333333"
                                android:background="@drawable/bg_edit_text"
                                android:padding="12dp"
                                android:inputType="number"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Peso (kg):"
                                android:textSize="12sp"
                                android:textColor="#999999"
                                android:layout_marginBottom="4dp"/>

                            <EditText
                                android:id="@+id/etWeight"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Peso"
                                android:textSize="14sp"
                                android:textColor="#333333"
                                android:background="@drawable/bg_edit_text"
                                android:padding="12dp"
                                android:inputType="numberDecimal"/>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Sexo -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sexo:"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:layout_marginBottom="4dp"/>

                    <Spinner
                        android:id="@+id/spinnerGender"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_edit_text"
                        android:padding="8dp"
                        android:layout_marginBottom="16dp"/>

                    <!-- Color (SPINNER) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Color:"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:layout_marginBottom="4dp"/>

                    <Spinner
                        android:id="@+id/spinnerColor"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_edit_text"
                        android:padding="8dp"
                        android:layout_marginBottom="16dp"/>

                    <!-- Dueño -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dueño:"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvOwnerSelected"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cargando dueños..."
                        android:textSize="14sp"
                        android:textColor="#777777"
                        android:background="@drawable/bg_edit_text"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectOwner"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Cambiar Dueño"
                        android:textSize="13sp"
                        app:cornerRadius="8dp"
                        android:backgroundTint="#0c607d"
                        android:layout_marginBottom="16dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        app:strokeColor="#0c607d"
                        android:textColor="#0c607d"/>

                    <!-- Notas -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notas adicionales:"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etNotes"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:hint="Notas"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:background="@drawable/bg_edit_text"
                        android:padding="12dp"
                        android:gravity="top"
                        android:inputType="textMultiLine"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Botón Actualizar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Actualizar Paciente"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                android:backgroundTint="#2E7D32"
                android:layout_marginBottom="12dp"/>

        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="© 2025 Veterinaria Amor y lealtad"
            android:textSize="12sp"
            android:textColor="#999999"
            android:gravity="center"
            android:padding="16dp"/>

    </LinearLayout>
</ScrollView>