<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Barra azul (sin botón Guardar) -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#0c607d"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_back"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="@android:color/white"
                    android:contentDescription="Volver"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Crear Cita"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"/>


            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Foto de la mascota seleccionada -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    app:cardCornerRadius="50dp"
                    app:cardElevation="4dp">

                    <ImageView
                        android:id="@+id/ivPetPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_add_photo"
                        android:scaleType="centerCrop"
                        android:padding="20dp"
                        android:tint="#2E7D32"/>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Seleccionar mascota -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Seleccionar mascota:"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:layout_marginBottom="4dp"/>

                    <Spinner
                        android:id="@+id/spinnerPet"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_edit_text"
                        android:padding="8dp"
                        android:layout_marginBottom="16dp"/>

                    <!-- Dueño (auto-completado, solo lectura) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dueño:"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvOwnerName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Seleccione una mascota"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:background="@drawable/bg_edit_text"
                        android:gravity="center_vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="16dp"/>

                    <!-- Fecha -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fecha:"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="DD/MM/AAAA"
                        android:text="20/10/2025"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:background="@drawable/bg_edit_text"
                        android:padding="12dp"
                        android:inputType="date"
                        android:layout_marginBottom="16dp"/>

                    <!-- Hora -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hora:"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="HH:MM AM/PM"
                        android:text="10:00 AM"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:background="@drawable/bg_edit_text"
                        android:padding="12dp"
                        android:inputType="time"
                        android:layout_marginBottom="16dp"/>

                    <!-- Veterinario -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Veterinario:"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etVeterinarian"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nombre del veterinario"
                        android:text="Dra. María González"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:background="@drawable/bg_edit_text"
                        android:padding="12dp"
                        android:layout_marginBottom="16dp"/>

                    <!-- Motivo -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Motivo:"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Motivo de la consulta"
                        android:text="Consulta general"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:background="@drawable/bg_edit_text"
                        android:padding="12dp"
                        android:minHeight="80dp"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:layout_marginBottom="16dp"/>

                    <!-- Diagnóstico (opcional) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Diagnóstico (opcional):"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/etDiagnosis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Diagnóstico"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:background="@drawable/bg_edit_text"
                        android:padding="12dp"
                        android:minHeight="80dp"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:layout_marginBottom="16dp"/>

                    <!-- Estado -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estado:"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:layout_marginBottom="4dp"/>

                    <Spinner
                        android:id="@+id/spinnerStatus"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_edit_text"
                        android:padding="8dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Botón Crear Cita (único) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Crear Cita"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                android:backgroundTint="#2E7D32"
                android:layout_marginBottom="12dp"/>

        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="© 2025 Veterinaria Amor y lealtad"
            android:textSize="12sp"
            android:textColor="#999999"
            android:gravity="center"
            android:padding="16dp"/>

    </LinearLayout>
</ScrollView>