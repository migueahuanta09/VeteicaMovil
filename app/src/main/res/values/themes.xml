<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema principal de VETEICA -->
    <style name="Theme.VeteicaApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/veteica_green</item>
        <item name="colorPrimaryVariant">@color/veteica_green_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/veteica_orange</item>
        <item name="colorSecondaryVariant">@color/veteica_orange</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/veteica_green_dark</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/white</item>

        <!-- Default text colors -->
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/veteica_gray</item>

        <!-- Action bar -->
        <item name="actionBarSize">56dp</item>
    </style>

    <!-- Tema para pantallas de formulario -->
    <style name="Theme.VeteicaApp.Form" parent="Theme.VeteicaApp">
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

</resources>